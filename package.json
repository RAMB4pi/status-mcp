{
  "name": "@harthad/status-mcp",
  "version": "0.8.2",
  "private": true,
  "description": "Open-source functional MCP server and plugin for Harthad Status",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/src/server.js",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "package:plugin": "python3 scripts/package-plugin.py",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "~5.9.3"
  },
  "exports": {
    ".": "./dist/src/tools/index.js",
    "./client": "./dist/src/client/index.js"
  },
  "files": [
    "dist/src",
    "LICENSE",
    "README.md"
  ]
}
